// ==UserScript==
// @name         ContaHub - Desconto 100% + Zerar Qtd Pessoas +  Fechar Venda + Apenas autorizados
// @namespace    http://tampermonkey.net/
// @version      1.5
// @description  Aplicar desconto 100%, zerar pessoas e fechar venda
// @match        https://sp.contahub.com/*
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    // =========================
    // USUÁRIOS AUTORIZADOS
    // =========================
    const donosAutorizados = [
        'aldy@664',
        'jullios@664'
    ];

    // =========================
    // VALIDA USUÁRIO
    // =========================
    function usuarioAutorizado() {

        return (
            window.contahub &&
            window.contahub.u &&
            donosAutorizados.includes(window.contahub.u.usr_email)
        );
    }

    // =========================
    // UTIL
    // =========================
    function sleep(ms) {
        return new Promise(function(resolve) {
            setTimeout(resolve, ms);
        });
    }

    // =========================
    // FUNÇÃO PRINCIPAL
    // =========================
    async function aplicarDesconto100() {

        try {

            console.log("=== INICIANDO PROCESSO ===");

            // =========================
            // MENU
            // =========================
            const butMenu = document.querySelector('#butMenu');

            if (butMenu) {
                butMenu.click();
            }

            await sleep(400);

            // =========================
            // DESCONTOS
            // =========================
            const butDesconto = document.querySelector('#butDesconto');

            if (butDesconto) {
                butDesconto.click();
            }

            await sleep(800);

            // =========================
            // MARCAR TODOS
            // =========================
            const chkTudo = document.querySelector('#chkTudo');

            if (chkTudo) {

                chkTudo.checked = true;

                chkTudo.dispatchEvent(new Event('change', {
                    bubbles: true
                }));

                if (window.rightObj && window.rightObj.chkTudo) {
                    window.rightObj.chkTudo(chkTudo);
                }
            }

            await sleep(1200);

            // =========================
            // INPUT 100
            // =========================
            const inputValor = document.querySelector('#inputValor');

            if (inputValor) {

                inputValor.focus();

                inputValor.value = '100';

                inputValor.dispatchEvent(new Event('input', {
                    bubbles: true
                }));

                inputValor.dispatchEvent(new Event('change', {
                    bubbles: true
                }));
            }

            await sleep(1500);

            // =========================
            // APLICAR
            // =========================
            const butAplica = document.querySelector('#butAplica');

            if (butAplica) {
                butAplica.click();
            }

            await sleep(1800);

            // =========================
            // VOLTAR
            // =========================
            const butVoltar = document.querySelector('#butVoltar');

            if (butVoltar) {
                butVoltar.click();
            }

            await sleep(1200);

            // =========================
            // ZERAR PESSOAS
            // =========================
            const vdPessoas = document.querySelector('#vd_pessoas');

            if (vdPessoas) {

                vdPessoas.value = '0';

                Array.from(vdPessoas.options).forEach(function(opt) {
                    opt.selected = false;
                });

                const optionZero = vdPessoas.querySelector('option[value="0"]');

                if (optionZero) {
                    optionZero.selected = true;
                }

                vdPessoas.dispatchEvent(new Event('change', {
                    bubbles: true
                }));

                vdPessoas.dispatchEvent(new Event('input', {
                    bubbles: true
                }));

                if (window.vendaView && window.vendaView.pessoas) {
                    window.vendaView.pessoas('0');
                }

                if (window.$) {
                    try {
                        window.$('#vd_pessoas').selectmenu('refresh', true);
                    } catch(e) {}
                }
            }

            await sleep(1000);

            // =========================
            // FECHAR VENDA
            // =========================
            const butSomenteFecha = document.querySelector('#butSomenteFecha');

            if (butSomenteFecha) {
                butSomenteFecha.click();
            }

            console.log("=== PROCESSO FINALIZADO ===");

        } catch (e) {

            console.error("ERRO:", e);
        }
    }

    // =========================
    // BOTÃO FLUTUANTE
    // =========================
    function criarBotao() {

        // SEGURANÇA
        if (!usuarioAutorizado()) {
            return;
        }

        // EVITA DUPLICAR
        if (document.getElementById('btn-desconto-100')) {
            return;
        }

        const btn = document.createElement('button');

        btn.id = 'btn-desconto-100';

        btn.innerText = 'DESC 100%';

        btn.style.position = 'fixed';
        btn.style.bottom = '20px';
        btn.style.right = '20px';

        btn.style.zIndex = '999999';

        btn.style.background = 'transparent';
        btn.style.color = '#7f7f7f';
        btn.style.border = 'none';

        btn.style.padding = '14px 18px';

        btn.style.borderRadius = '12px';

        btn.style.fontSize = '14px';
        btn.style.fontWeight = 'normal';

        btn.style.cursor = 'pointer';

        btn.style.boxShadow = '0 1px 2px rgba(0,0,0,0.4)';

        btn.onclick = aplicarDesconto100;

        document.body.appendChild(btn);

        console.log("Botão criado");
    }

    // =========================
    // INIT
    // =========================
    const init = setInterval(function () {

        if (
            document.body &&
            window.contahub &&
            window.contahub.u
        ) {

            criarBotao();

            clearInterval(init);
        }

    }, 1000);

})();
