// ==UserScript==
// @name         ContaHub - Desconto 100% + Fechar Venda & Add PG & Zerar Pessoas
// @namespace    http://tampermonkey.net/
// @version      2.2
// @description  Três botões: Zerar Pessoas, Add PG e Desc 100%
// @match        https://sp.contahub.com/*
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    // =========================
    // USUÁRIOS AUTORIZADOS
    // =========================
    const donosAutorizados = [
        'aldy@664',
        'jullios@664'
    ];

    // =========================
    // VALIDA USUÁRIO
    // =========================
    function usuarioAutorizado() {
        return (
            window.contahub &&
            window.contahub.u &&
            donosAutorizados.includes(window.contahub.u.usr_email)
        );
    }

    // =========================
    // UTIL
    // =========================
    function sleep(ms) {
        return new Promise(function(resolve) {
            setTimeout(resolve, ms);
        });
    }

    // =========================
    // FUNÇÃO 1: DESCONTO 100%
    // =========================
    async function aplicarDesconto100() {
        try {
            console.log("=== INICIANDO DESCONTO 100% ===");

            const butMenu = document.querySelector('#butMenu');
            if (butMenu) butMenu.click();
            await sleep(400);

            const butDesconto = document.querySelector('#butDesconto');
            if (butDesconto) butDesconto.click();
            await sleep(800);

            const chkTudo = document.querySelector('#chkTudo');
            if (chkTudo) {
                chkTudo.checked = true;
                chkTudo.dispatchEvent(new Event('change', { bubbles: true }));
                if (window.rightObj && window.rightObj.chkTudo) {
                    window.rightObj.chkTudo(chkTudo);
                }
            }
            await sleep(1200);

            const inputValor = document.querySelector('#inputValor');
            if (inputValor) {
                inputValor.focus();
                inputValor.value = '100';
                inputValor.dispatchEvent(new Event('input', { bubbles: true }));
                inputValor.dispatchEvent(new Event('change', { bubbles: true }));
            }
            await sleep(1500);

            const butAplica = document.querySelector('#butAplica');
            if (butAplica) butAplica.click();
            await sleep(1800);

            const butVoltar = document.querySelector('#butVoltar');
            if (butVoltar) butVoltar.click();
            await sleep(1200);

            const vdPessoas = document.querySelector('#vd_pessoas');
            if (vdPessoas) {
                vdPessoas.value = '0';
                Array.from(vdPessoas.options).forEach(opt => opt.selected = false);
                const optionZero = vdPessoas.querySelector('option[value="0"]');
                if (optionZero) optionZero.selected = true;

                vdPessoas.dispatchEvent(new Event('change', { bubbles: true }));
                vdPessoas.dispatchEvent(new Event('input', { bubbles: true }));

                if (window.vendaView && window.vendaView.pessoas) {
                    window.vendaView.pessoas('0');
                }
                if (window.$) {
                    try { window.$('#vd_pessoas').selectmenu('refresh', true); } catch(e) {}
                }
            }
            await sleep(1000);

            const butSomenteFecha = document.querySelector('#butSomenteFecha');
            if (butSomenteFecha) butSomenteFecha.click();

            console.log("=== PROCESSO FINALIZADO ===");

        } catch (e) {
            console.error("ERRO:", e);
        }
    }

    // =========================
    // FUNÇÃO 2: ADICIONAR "PG "
    // =========================
    async function adicionarPG() {
        try {
            console.log("=== INICIANDO ADICIONAR PG ===");

            const butMenu = document.querySelector('#butMenu');
            if (butMenu) butMenu.click();
            await sleep(400);

            const butInfo = document.querySelector('#butInfo');
            if (butInfo) butInfo.click();
            await sleep(800);

            const inputComanda = document.querySelector('#vd_mesadesc');
            if (inputComanda) {
                let valorAtual = inputComanda.value.trim();

                if (!valorAtual.toUpperCase().startsWith('PG')) {
                    inputComanda.value = valorAtual ? 'PG ' + valorAtual : 'PG';

                    inputComanda.dispatchEvent(new Event('input', { bubbles: true }));
                    inputComanda.dispatchEvent(new Event('change', { bubbles: true }));
                    inputComanda.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true }));

                    if (window.index && window.index.renewPanelDireita) {
                        window.index.renewPanelDireita();
                    }
                }
            }
            await sleep(800);

            const butSave = document.querySelector('#butSave');
            if (butSave) butSave.click();

            await sleep(1000);

            console.log("Fechando a tela de Dados...");

            const butVoltar = document.querySelector('#butVoltar');
            if (butVoltar) {
                butVoltar.click();
            } else {
                if (window.index && typeof window.index.closePanelDireita === 'function') {
                    window.index.closePanelDireita();
                } else {
                     const overlay = document.querySelector('.ui-panel-dismiss-open');
                     if (overlay) overlay.click();
                }
            }

            console.log("=== PROCESSO ADICIONAR PG FINALIZADO ===");

        } catch (e) {
            console.error("ERRO NO ADICIONAR PG:", e);
        }
    }

    // =========================
    // FUNÇÃO 3: ZERAR PESSOAS
    // =========================
    async function zerarPessoas() {
        try {
            console.log("=== INICIANDO ZERAR PESSOAS ===");

            const vdPessoas = document.querySelector('#vd_pessoas');
            if (vdPessoas) {
                vdPessoas.value = '0';
                Array.from(vdPessoas.options).forEach(opt => opt.selected = false);
                const optionZero = vdPessoas.querySelector('option[value="0"]');
                if (optionZero) optionZero.selected = true;

                vdPessoas.dispatchEvent(new Event('change', { bubbles: true }));
                vdPessoas.dispatchEvent(new Event('input', { bubbles: true }));

                if (window.vendaView && window.vendaView.pessoas) {
                    window.vendaView.pessoas('0');
                }
                if (window.$) {
                    try { window.$('#vd_pessoas').selectmenu('refresh', true); } catch(e) {}
                }
            }

            await sleep(500);

            // === VOLTAR / FECHAR PAINEL ===
            console.log("Garantindo que o painel seja fechado...");

            const butVoltar = document.querySelector('#butVoltar');
            if (butVoltar) {
                butVoltar.click();
            } else {
                if (window.index && typeof window.index.closePanelDireita === 'function') {
                    window.index.closePanelDireita();
                } else {
                     const overlay = document.querySelector('.ui-panel-dismiss-open');
                     if (overlay) overlay.click();
                }
            }

            console.log("=== PROCESSO ZERAR PESSOAS FINALIZADO ===");

        } catch (e) {
            console.error("ERRO NO ZERAR PESSOAS:", e);
        }
    }

    // =========================
    // UI: CONTAINER E BOTÕES
    // =========================
    function criarBotoes() {
        if (!usuarioAutorizado()) return;

        if (document.getElementById('container-botoes-contahub')) return;

        const container = document.createElement('div');
        container.id = 'container-botoes-contahub';
        container.style.position = 'fixed';
        container.style.bottom = '20px';
        container.style.right = '20px';
        container.style.zIndex = '999998';
        container.style.display = 'flex';
        container.style.gap = '10px';

        // Botão 1: ZERAR PESSOAS
        const btnZero = document.createElement('button');
        btnZero.innerText = '0';
        btnZero.style.background = '#64B5F6'; // Azul Claro
        btnZero.style.color = '#fff';
        btnZero.style.border = 'none';
        btnZero.style.padding = '14px 18px';
        btnZero.style.borderRadius = '12px';
        btnZero.style.fontSize = '14px';
        btnZero.style.fontWeight = 'bold';
        btnZero.style.cursor = 'pointer';
        btnZero.style.boxShadow = '0 2px 4px rgba(0,0,0,0.3)';
        btnZero.onclick = zerarPessoas;

        // Botão 2: ADD PG
        const btnPG = document.createElement('button');
        btnPG.innerText = 'PG';
        btnPG.style.background = '#81C784';
        btnPG.style.color = '#fff';
        btnPG.style.border = 'none';
        btnPG.style.padding = '14px 18px';
        btnPG.style.borderRadius = '12px';
        btnPG.style.fontSize = '14px';
        btnPG.style.fontWeight = 'bold';
        btnPG.style.cursor = 'pointer';
        btnPG.style.boxShadow = '0 2px 4px rgba(0,0,0,0.3)';
        btnPG.onclick = adicionarPG;

        // Botão 3: DESC 100%
        const btnDesc = document.createElement('button');
        btnDesc.innerText = '100%';
        btnDesc.style.background = '#ffc0a5';
        btnDesc.style.color = '#333';
        btnDesc.style.border = 'none';
        btnDesc.style.padding = '14px 18px';
        btnDesc.style.borderRadius = '12px';
        btnDesc.style.fontSize = '14px';
        btnDesc.style.fontWeight = 'bold';
        btnDesc.style.cursor = 'pointer';
        btnDesc.style.boxShadow = '0 2px 4px rgba(0,0,0,0.3)';

        btnDesc.onclick = function() {
            if (document.getElementById('caixa-confirmacao-100')) return;

            const confirmBox = document.createElement('div');
            confirmBox.id = 'caixa-confirmacao-100';
            confirmBox.style.position = 'fixed';
            confirmBox.style.bottom = '80px';
            confirmBox.style.right = '20px';
            confirmBox.style.zIndex = '999999';
            confirmBox.style.background = '#ffffff';
            confirmBox.style.border = '1px solid #ccc';
            confirmBox.style.padding = '15px';
            confirmBox.style.borderRadius = '8px';
            confirmBox.style.boxShadow = '0 4px 8px rgba(0,0,0,0.2)';
            confirmBox.style.textAlign = 'center';
            confirmBox.style.fontFamily = 'Arial, sans-serif';

            confirmBox.innerHTML = `
                <p style="margin: 0 0 15px 0; font-size: 14px; color: #333; font-weight: bold;">
                    Aplicar 100% de desconto e fechar?
                </p>
                <button id="btn-confirma-sim" style="background: #4CAF50; color: white; border: none; padding: 8px 15px; cursor: pointer; border-radius: 4px; margin-right: 10px; font-weight: bold;">
                    SIM
                </button>
                <button id="btn-confirma-nao" style="background: #f44336; color: white; border: none; padding: 8px 15px; cursor: pointer; border-radius: 4px; font-weight: bold;">
                    NÃO
                </button>
            `;

            document.body.appendChild(confirmBox);

            document.getElementById('btn-confirma-sim').onclick = function() {
                confirmBox.remove();
                aplicarDesconto100();
            };

            document.getElementById('btn-confirma-nao').onclick = function() {
                confirmBox.remove();
            };
        };

        // Adiciona os botões no container na ordem desejada (da esquerda para a direita)
        container.appendChild(btnZero);
        container.appendChild(btnPG);
        container.appendChild(btnDesc);

        document.body.appendChild(container);
    }

    // =========================
    // INIT
    // =========================
    const init = setInterval(function () {
        if (document.body && window.contahub && window.contahub.u) {
            criarBotoes();
            clearInterval(init);
        }
    }, 1000);

})();
